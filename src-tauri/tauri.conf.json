{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trimbit",
  "version": "2.1.0",
  "identifier": "io.github.oguztozkoparan.trimbit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui-dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "capabilities": [
        "panel"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Headroom savings in your menu bar",
    "longDescription": "Trimbit is an unofficial menu bar companion for the Headroom proxy. It shows live token and cost savings, proxy health and request stats. Not affiliated with the Headroom project.",
    "copyright": "© 2026 Mehmet Oğuz Tozkoparan",
    "publisher": "Mehmet Oğuz Tozkoparan",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5M0NBQTFEN0Y5RTkyMTQKUldRVWtwNS9IYW84aWY5OCtiaktOZFR2clU3MHQvYmpJS2R4Tyt0V3RUVmRQSWd0cnNPdFNuTW0K",
      "endpoints": [
        "https://github.com/oguztozkoparan/trimbit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
