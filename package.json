{
  "name": "trimbit",
  "private": true,
  "version": "2.1.0",
  "description": "An unofficial menu bar companion for the Headroom proxy",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "icons": "tauri icon branding/png/app-icon-1024.png",
    "site:dev": "vite --config website/vite.config.ts",
    "site:build": "tsc --noEmit && vite build --config website/vite.config.ts && cp branding/png/social-card.png website/dist/"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
